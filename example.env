# GlowCTF Environment Configuration

# ===== DATABASE CONFIGURATION =====
# Choose one database option:

# Option 1: MySQL Configuration (Recommended for local development)
DB_HOST=localhost
DB_USER=glowctf_user
DB_PASSWORD=your_strong_password  # Must match the password used when creating the MySQL user
DB_NAME=glowctf
DB_PORT=3306
# Alternative MySQL connection string format
MYSQL_DATABASE_URL=mysql://glowctf_user:your_strong_password@localhost:3306/glowctf

# Option 2: PostgreSQL Configuration
# DATABASE_URL=postgresql://username:password@localhost:5432/glowctf

# ===== SESSION CONFIGURATION =====
# Required for secure user sessions
SESSION_SECRET=change_this_to_a_random_string

# ===== NODE ENVIRONMENT =====
# Development mode disables certain security features for easier local development
NODE_ENV=development
# NODE_ENV=production  # Use this for production deployments

# ===== AI PROVIDER API KEYS =====
# Add keys for the AI providers you want to use (all are optional)
# OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=your_anthropic_api_key
# GEMINI_API_KEY=your_gemini_api_key
# GROQ_API_KEY=your_groq_api_key
# TOGETHER_API_KEY=your_together_api_key

# ===== SERVER CONFIGURATION =====
# Optional: Configure the port the server runs on (defaults to 5000)
# PORT=5000

# ===== EMAIL CONFIGURATION =====
# Optional: For email functionality if implemented
# SENDGRID_API_KEY=your_sendgrid_api_key
# EMAIL_FROM=noreply@example.com